# chora-closure-orchestrator — example environment.
# Copy to .env and adjust. Every value is injected by the deployment
# (compose / operator); there are no inline defaults beyond the dev
# escape hatches noted below.

# --- Database (chora_ai_kernel: coordinator repo + outbox + wrapped-DEK store)
# Direct DSN wins; otherwise CHORA_AI_KERNEL_PG_DSN_SECRET_ID is used as an
# env-backed secret alias whose value IS the DSN.
# CHORA_AI_KERNEL_PG_DSN=postgresql://chora_ai_kernel_app_rw:PASSWORD@postgres:5432/chora_ai_kernel
# CHORA_AI_KERNEL_PG_DSN_SECRET_ID=

# --- Event bus (NATS JetStream)
CHORA_NATS_URL=nats://nats:4222

# --- Envelope source name (stamped into the event envelope; enables the
# --- outbox dispatcher when the DSN is also set)
CHORA_SOURCE_PROJECT=chora-local

# --- Local KMS master KEK (base64-encoded 32 bytes; env-backed secret)
# Generate with: openssl rand -base64 32
# CHORA_LOCAL_KEK=

# --- Cold archive (MinIO)
# CHORA_COLD_ARCHIVE_BUCKET=chora-cold-archive
# CHORA_MINIO_ENDPOINT=minio:9000
# CHORA_MINIO_ACCESS_KEY=
# CHORA_MINIO_SECRET_KEY=
# CHORA_MINIO_SECURE=false

# --- Per-domain ack subscriptions (comma-joined NATS subjects)
# CLOSURE_ACK_SUBSCRIPTIONS=chora.creation.account.pseudonymised.v1,chora.consumption.account.pseudonymised.v1,chora.delivery.account.pseudonymised.v1,chora.sharing.account.pseudonymised.v1,chora.a2a.account.pseudonymised.v1,chora.identity.account.pseudonymised.v1,chora.tenancy.account.pseudonymised.v1,chora.governance.account.pseudonymised.v1,chora.observability.account.pseudonymised.v1,chora.notifications.account.pseudonymised.v1

# --- Poll intervals + ack timeout
# CLOSURE_DRIVER_POLL_SECONDS=30
# CLOSURE_OUTBOX_POLL_SECONDS=0.5
# CLOSURE_ACK_TIMEOUT_SECONDS=86400

# --- Tracing (OTLP-gRPC collector; unset = no-op)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Dev escape hatch: force in-memory/fake adapters (NEVER set in prod)
# CHORA_CLOSURE_FAKE_ADAPTERS=false
